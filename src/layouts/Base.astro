---
import site from '../data/site.json';
const {title = site.name,description=site.intro} = Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const href=(path='/')=>`${base}${path}`;
---
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#faf8f5"/><title>{title} — {site.name}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/></head><body><div class="page-shell"><header class="topbar"><a class="logo" href={href('/')}>abk<span class="logo-dot">.</span></a><nav aria-label="Main navigation"><a href={href('/#work')}>Work</a><a href={href('/#about')}>About</a><a class="nav-pill" href={href('/#contact')}>Let's talk <span aria-hidden="true">↗</span></a></nav></header><slot/><footer class="footer"><a class="logo" href={href('/')}>abk<span class="logo-dot">.</span></a><span>Made with curiosity & a little color ✳</span><span>© {new Date().getFullYear()} {site.name}</span></footer></div></body></html>
<style is:global>
:root{font-family:'DM Sans',sans-serif;color:#22232c;background:#faf8f5;font-synthesis:none;scroll-behavior:smooth}*{box-sizing:border-box}body{margin:0}a{text-decoration:none;color:inherit}button{font:inherit}img{max-width:100%;display:block}.page-shell{max-width:1350px;padding:0 clamp(20px,5.3vw,80px);margin:auto}.topbar{height:106px;display:flex;align-items:center;justify-content:space-between}.logo{font:800 30px 'Manrope',sans-serif;letter-spacing:-2px}.logo-dot{color:#8b6ce8}.topbar nav{display:flex;align-items:center;gap:30px;font-size:14px;font-weight:700}.topbar nav a:not(.nav-pill):hover{color:#7660d9}.nav-pill,.button-primary{background:#24242f;color:#fff;border-radius:999px;padding:13px 22px;display:inline-flex;align-items:center;gap:17px;transition:transform .2s,background .2s}.nav-pill:hover,.button-primary:hover{background:#6b56bc;transform:translateY(-2px)}.eyebrow{font-size:12px;letter-spacing:2.2px;font-weight:800;text-transform:uppercase;color:#716e7d}.section-kicker{font-size:12px;letter-spacing:2px;font-weight:800;text-transform:uppercase;color:#796bb5}.section-heading{font-family:Manrope,sans-serif;font-size:clamp(30px,4vw,46px);letter-spacing:-2px;line-height:1.18;margin:12px 0 30px}.footer{display:flex;justify-content:space-between;align-items:center;padding:48px 0 32px;border-top:1px solid #e8e4e2;margin-top:95px;color:#8c8793;font-size:12px}.footer .logo{color:#22232c}@media(max-width:650px){.topbar{height:78px}.topbar nav{gap:13px;font-size:12px}.topbar .nav-pill{padding:10px 13px}.footer{gap:15px;flex-wrap:wrap}.footer span:nth-child(2){display:none}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>
