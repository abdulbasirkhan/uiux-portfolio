---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const files = import.meta.glob('../data/projects/*.json',{eager:true,import:'default'});
const projects=Object.entries(files).map(([file,p])=>({...p,slug:file.split('/').pop().replace('.json','')})).sort((a,b)=>(a.order||999)-(b.order||999));
const featured=projects.filter(p=>p.featured);
const others=projects.filter(p=>!p.featured);
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const asset=p=>`${root}${p}`;
// Values are edited from the Homepage & About collection in Pages CMS.
const validHex = (value,fallback) => /^#[0-9a-fA-F]{6}$/.test(value||'') ? value : fallback;
const heroStart=validHex(site.heroBackgroundStart,'#342D55');
const heroEnd=validHex(site.heroBackgroundEnd,'#635383');
const heroColor=validHex(site.heroTextColor,'#FFFFFF');
const aboutStart=validHex(site.aboutBackgroundStart,'#EAE3F7');
const aboutEnd=validHex(site.aboutBackgroundEnd,'#DFECF1');
const photoPosition=/^[\w% -]+$/.test(site.aboutPhotoPosition||'') ? site.aboutPhotoPosition : 'center';
const heroImage=site.heroBackgroundImage ? `url("${asset(site.heroBackgroundImage)}")` : 'none';
const imagePosition=/^[\w% -]+$/.test(site.heroBackgroundPosition||'') ? site.heroBackgroundPosition : 'center';
const visualPosition=/^[\w% -]+$/.test(site.heroVisualPosition||'') ? site.heroVisualPosition : 'center';
---
<Base title="Product & UI/UX Designer"><main>
<section class="hero" style={`--hero-start:${heroStart};--hero-end:${heroEnd};--hero-color:${heroColor};--hero-image:${heroImage};--hero-image-position:${imagePosition};`}><div class="hero-copy"><div class="availability"><span class="pulse"></span> Designing thoughtful digital experiences</div><p class="eyebrow">{site.eyebrow}</p><h1>{site.headline}</h1><p class="hero-intro">{site.intro}</p><a href="#work" class="button-primary">Explore my work <span>↗</span></a><div class="hero-foot">Based in {site.location} <span class="hand">✳</span> Designing for people, not just pixels.</div></div><div class="hero-art" style={`--hero-visual-position:${visualPosition}`}>
{site.heroVisualImage
  ? <img class="hero-visual-image" src={asset(site.heroVisualImage)} alt={site.heroVisualAlt || 'Portfolio hero artwork'} fetchpriority="high" />
  : <div class="hero-illustration" aria-hidden="true"><div class="art-card back-card"></div><div class="art-card main-card"><div class="orb orb-one"></div><div class="orb orb-two"></div><div class="art-screen"><div class="screen-top"><i></i><i></i><i></i></div><div class="mock-sidebar"></div><div class="mock-content"><div class="mock-bar"></div><div class="mock-stats"><div></div><div></div><div></div></div><div class="mock-wave"></div><div class="mock-lines"></div></div></div></div><div class="art-bubble bubble1">✦</div><div class="art-bubble bubble2">✳</div><div class="mini-sticker">good design<br/>feels good ☻</div></div>}
</div></section>
<section id="work" class="work-section"><div class="heading-row"><div><h2 class="section-heading">Selected work<span class="colored-star"> ✳</span></h2></div><p>A mix of complex platforms, useful products, and little details that make a big difference.</p></div><div class="projects-grid">{featured.map((p,i)=><a class={`project-card project-${i}`} href={`${root}/work/${p.slug}/`}><div class="project-image"><img src={asset(p.image)} alt={`${p.title} project presentation`} loading="lazy"/><span class="corner-arrow" aria-hidden="true">↗</span></div><div class="project-caption"><div><span class="project-category">{p.category}</span><h3>{p.title}</h3><p>{p.tagline}</p></div><span class="view-work">View case study ↗</span></div></a>)}</div></section>
{others.length>0 && <section class="other-work"><div><h2 class="section-heading">Other explorations</h2></div><div class="other-grid">{others.map(p=><a href={`${root}/work/${p.slug}/`} class="other-item"><img src={asset(p.image)} alt={`${p.title} project screenshot`} loading="lazy"/><div><h3>{p.title} ↗</h3><p>{p.category}</p></div></a>)}</div></section>}
<section id="about" class="about-section" style={`--about-start:${aboutStart};--about-end:${aboutEnd};--photo-position:${photoPosition}`}>
  <div class="about-visual">
    <div class="portrait-frame">
      {site.aboutPhoto ? <img class="portrait-image" src={asset(site.aboutPhoto)} alt="Portrait of Abdul Basir Khan" loading="lazy"/> : <div class="portrait-placeholder"><span class="portrait-symbol">ABK<span>✳</span></span><small>Your portrait goes here — add it in Pages CMS</small></div>}
    </div>
  </div>
  <div class="about-copy"><h2>{site.aboutTitle || 'Design-minded. People-focused.'}</h2><p class="about-lead">{site.aboutLead}</p><p>{site.about}</p><p>{site.aboutExtra}</p><div class="skills"><span>Enterprise UX</span><span>Product design</span><span>Wireframing</span><span>Design systems</span><span>Prototyping</span><span>Motion & storytelling</span></div><a class="about-cta" href={`mailto:${site.email}`}>Let's connect <span aria-hidden="true">↗</span></a></div>
</section>
<section id="contact" class="contact-section"><h2>Let's make something<br/><em>really good</em> together. <span>✦</span></h2><div class="contact-actions"><a class="button-primary" href={`mailto:${site.email}`}>Say hello <span>↗</span></a><a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="link-social">Find me on LinkedIn ↗</a></div></section>
</main></Base>
<style>
.hero{min-height:620px;padding:52px 45px 70px;margin:0 -45px 90px;border-radius:36px;color:var(--hero-color);background-image:linear-gradient(110deg, var(--hero-start) 0%, var(--hero-end) 100%),var(--hero-image);background-blend-mode:multiply;background-position:center,var(--hero-image-position);background-size:cover;isolation:isolate;display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center}.hero-copy{position:relative;z-index:2}.availability{font-size:12px;background:#ffffff18;border:1px solid #ffffff40;border-radius:100px;display:inline-flex;align-items:center;gap:8px;padding:9px 14px;color:#f7f2ff;margin-bottom:29px}.pulse{background:#74c5a2;width:8px;height:8px;border-radius:50%;box-shadow:0 0 0 4px #dff4e9}.hero .eyebrow{color:#dcd1ff}.hero .button-primary{background:#fff;color:#252037}.hero .button-primary:hover{background:#eadfff}.hero h1{font:800 clamp(46px,5.6vw,79px)/1.14 Manrope,sans-serif;letter-spacing:-4.3px;margin:16px 0 25px;max-width:720px}.hero-intro{font-size:17px;line-height:1.8;color:#eee6fc;max-width:550px;margin:0 0 31px}.hero-foot{font-size:12px;color:#e0d7ef;margin-top:42px}.hero-foot .hand{padding:0 14px;color:#db92a0}.hero-art{height:480px;position:relative;display:flex;align-items:center;justify-content:center}.hero-illustration{width:100%;height:100%;position:relative;display:flex;align-items:center;justify-content:center}.hero-visual-image{width:100%;height:100%;object-fit:contain;object-position:var(--hero-visual-position);display:block}.art-card{border-radius:35px;position:absolute;width:83%;height:72%;transform:rotate(-7deg)}.back-card{background:#f8bcbb;transform:rotate(11deg) translate(8px,10px)}.main-card{overflow:hidden;background:linear-gradient(140deg,#cfbefc,#a1d7db 75%);box-shadow:0 25px 55px #756ab02b;transform:rotate(-6deg)}.orb{position:absolute;border-radius:50%;filter:blur(2px)}.orb-one{height:190px;width:190px;right:-60px;top:-40px;background:#ffedc2}.orb-two{height:150px;width:150px;left:-50px;bottom:-35px;background:#fbb7be}.art-screen{position:absolute;inset:19% 13%;border:8px solid #fff;border-radius:18px;background:#fdfcfe;box-shadow:0 17px 36px #625da147;overflow:hidden;transform:rotate(6deg)}.screen-top{height:18%;border-bottom:1px solid #eee;display:flex;align-items:center;gap:5px;padding-left:14px}.screen-top i{width:7px;height:7px;background:#d7c8fa;border-radius:100%}.screen-top i:nth-child(2){background:#ffbbad}.screen-top i:nth-child(3){background:#b3e3d3}.mock-sidebar{width:22%;height:82%;position:absolute;background:#f2edfd}.mock-content{position:absolute;left:27%;top:25%;width:67%}.mock-bar{width:50%;height:12px;background:#ccc1ef;border-radius:5px;margin-bottom:16px}.mock-stats{display:flex;gap:7px}.mock-stats div{width:33%;height:44px;background:#f7d8d8;border-radius:6px}.mock-stats div:nth-child(2){background:#d8eee7}.mock-stats div:nth-child(3){background:#ece4fc}.mock-wave{width:100%;height:58px;border-radius:9px;background:linear-gradient(155deg,#efebfe 15%,#b7a5e7 15% 18%,#ebdef8 18% 36%,#b7a5e7 36% 39%,#e4e8fa 39%);margin-top:10px}.mock-lines{width:65%;height:8px;border-radius:4px;background:#e6e2ee;margin-top:15px}.art-bubble{position:absolute;display:grid;place-items:center;border-radius:50%;box-shadow:0 12px 22px #7772a12b}.bubble1{top:23px;right:38px;background:#ffe5a7;width:84px;height:84px;color:#f39a36;font-size:48px}.bubble2{bottom:35px;left:8px;background:#b9ecd5;width:72px;height:72px;color:#438a7f;font-size:43px}.mini-sticker{position:absolute;right:0;bottom:33px;background:#fff;border-radius:15px;padding:15px 19px;transform:rotate(8deg);box-shadow:0 10px 25px #aaa2b72d;font-size:12px;font-weight:800;color:#7a61b5;line-height:1.35}.heading-row{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:30px}.heading-row p{color:#85808c;max-width:295px;line-height:1.7;font-size:14px}.colored-star{color:#ac86ed}.projects-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:34px}.project-card{min-width:0}.project-image{height:345px;position:relative;border-radius:23px;overflow:hidden;background:#ece4fa}.project-image img{height:100%;width:100%;object-fit:cover;transition:transform .5s}.project-card:hover .project-image img{transform:scale(1.045)}.corner-arrow{position:absolute;right:19px;top:19px;background:white;width:43px;height:43px;border-radius:50%;display:grid;place-items:center;font-size:23px;box-shadow:0 4px 10px #0001}.project-1 .project-image{background:#d5e8f9}.project-2 .project-image{background:#e1dbff}.project-3 .project-image{background:#ceece9}.project-caption{display:flex;justify-content:space-between;gap:12px;align-items:end;padding:20px 3px 8px}.project-category{font-size:11px;letter-spacing:.6px;color:#9c91a7;font-weight:700}.project-caption h3{font:800 25px Manrope,sans-serif;letter-spacing:-.9px;margin:7px 0}.project-caption p{font-size:13px;color:#8a8591;margin:0;line-height:1.6}.view-work{font-size:11px;font-weight:700;white-space:nowrap;color:#7960b9;padding-bottom:4px}.other-work{margin-top:100px}.other-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.other-item img{height:175px;width:100%;object-fit:cover;border-radius:18px}.other-item h3{font-size:16px;margin:13px 0 4px}.other-item p{font-size:12px;color:#8d8793;margin:0}/* About portrait and editable gradient. */
.about-section{margin-top:110px;background:linear-gradient(135deg,var(--about-start),var(--about-end));border-radius:34px;padding:70px 6%;display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:8%;align-items:center;position:relative;isolation:isolate;overflow:hidden}

.about-visual{position:relative;min-height:410px;display:grid;place-items:center;isolation:isolate}
.portrait-frame{width:min(100%,350px);aspect-ratio:4/4.7;border-radius:32px;transform:rotate(-3deg);border:7px solid #ffffffb7;box-shadow:0 28px 55px #665b8533, inset 0 0 0 1px #ffffffa6;overflow:hidden;background:#d3c1e9;position:relative;z-index:2}
.portrait-image{height:100%;width:100%;object-fit:cover;object-position:var(--photo-position)}
.portrait-placeholder{height:100%;background:radial-gradient(circle at 30% 25%,#f8e1db 0,transparent 48%),linear-gradient(135deg,#b4a0e4,#7da6c7);display:flex;flex-direction:column;justify-content:center;align-items:center;gap:18px;color:white;text-align:center;padding:20px}
.portrait-symbol{font:800 clamp(60px,8vw,105px)/1 Manrope,sans-serif;letter-spacing:-7px;position:relative;text-shadow:0 10px 30px #524b8a55}.portrait-symbol span{position:absolute;font-size:35px;right:-24px;top:-10px;color:#ffdb93}.portrait-placeholder small{max-width:220px;font-size:12px;line-height:1.6;color:#fff;opacity:.87}
.about-copy{position:relative;z-index:4}.about-copy h2{font:800 clamp(32px,3.7vw,49px)/1.2 Manrope,sans-serif;letter-spacing:-2px;margin:0 0 21px;max-width:510px}.about-lead{font-size:19px!important;line-height:1.6!important;color:#383248!important;font-weight:700!important}.about-copy p{font-size:14px;line-height:1.85;color:#5f5b6e;max-width:590px;margin:0 0 14px}.skills{display:flex;gap:9px;flex-wrap:wrap;margin-top:21px}.skills span{background:#ffffffbd;padding:9px 13px;border:1px solid #fff8;border-radius:100px;font-size:11px;font-weight:700}.about-cta{margin-top:23px;display:inline-flex;gap:16px;align-items:center;color:#42366e;font-size:13px;font-weight:800;border-bottom:1px solid #8071a3;padding-bottom:6px}


.contact-section{text-align:center;padding:115px 0 35px}.contact-section h2{font:800 clamp(36px,5.5vw,68px)/1.15 Manrope,sans-serif;letter-spacing:-3px;margin:23px auto 30px}.contact-section h2 span{color:#e0ad8b}.contact-actions{display:flex;gap:22px;align-items:center;justify-content:center}.link-social{font-size:14px;font-weight:700;color:#6d6594}@media(max-width:900px){.hero{grid-template-columns:1fr;padding:40px 30px 55px;margin:0 -15px 65px}.hero-art{height:360px;max-width:530px;width:100%;margin:auto}.hero h1{font-size:58px}.project-image{height:280px}.view-work{display:none}.about-section{grid-template-columns:.85fr 1.15fr;gap:5%;padding:48px 4%}.about-visual{min-height:330px}}@media(max-width:650px){.hero{border-radius:24px;padding:35px 20px 40px;margin:0 -10px 55px}.hero h1{font-size:clamp(39px,11vw,53px);letter-spacing:-2.5px}.hero-intro{font-size:15px}.hero-art{height:300px}.hero-foot{line-height:2}.heading-row{display:block}.projects-grid,.other-grid{grid-template-columns:1fr}.project-image{height:280px}.project-caption h3{font-size:22px}.other-item img{height:210px}.about-section{grid-template-columns:1fr;padding:35px 25px 45px;gap:35px}.about-visual{min-height:360px}.portrait-frame{max-width:290px}.about-copy h2{font-size:34px}.about-lead{font-size:17px!important}.contact-section{padding:85px 0 20px}.contact-section h2{letter-spacing:-2px}.contact-actions{flex-wrap:wrap}}
</style>
