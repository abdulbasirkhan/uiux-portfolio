---
import Base from '../../layouts/Base.astro';
export function getStaticPaths(){
 const files=import.meta.glob('../../data/projects/*.json',{eager:true,import:'default'});
 return Object.entries(files).map(([file,project])=>({params:{slug:file.split('/').pop().replace('.json','')},props:{project}}));
}
const {project}=Astro.props;
const root=import.meta.env.BASE_URL.replace(/\/$/,'');
const asset=p=>`${root}${p}`;
const pseb=Astro.params.slug==='pseb';
// Pages CMS stores gallery items as { image, caption, alt } objects in project JSON.
const customGallery=Array.isArray(project.gallery)
  ? project.gallery.filter(item => typeof item?.image === 'string' && item.image.trim())
  : [];
// Preserve PSEB's existing gallery until the user adds custom entries in Pages CMS.
const legacyPsebGallery = pseb ? [
  {image:'/images/pseb-progress.png',caption:'Registration progress',alt:'PSEB registration progress'},
  {image:'/images/pseb-services.png',caption:'Products and services',alt:'PSEB products and services listing'},
  {image:'/images/pseb-messaging.png',caption:'Networking and messaging',alt:'PSEB messaging view'},
  {image:'/images/pseb-superadmin.png',caption:'Super-admin oversight',alt:'PSEB authority management dashboard'}
] : [];
const gallery = customGallery.length ? customGallery : legacyPsebGallery;
---
<Base title={project.title} description={project.summary}>
<main class="case">
<a href={`${root}/#work`} class="back">← Back to selected work</a>
<p class="kicker">{project.category}</p><h1>{project.title}<span class="star"> ✳</span></h1><p class="lead">{project.tagline}</p>
<div class="hero-img"><img src={asset(project.image)} alt={`${project.title} design presentation`} /></div>
<div class="case-content"><aside><span>PROJECT SNAPSHOT</span><p>{project.category}</p><span>FOCUS</span><p>UI/UX & visual design</p></aside>
<div class="story">
<section><h2>The challenge</h2><p>{project.summary}</p></section>
<section><h2>My approach</h2><p>{project.contribution}</p></section>
<section><h2>The experience</h2><p>{project.highlights}</p></section>
{pseb && <section><h2>Three pillars of the platform</h2><div class="pillar-list"><div><b>01 / Simplifying administration</b><p>Integrated documents, registration tracking, verification, payments, and approvals.</p></div><div><b>02 / Enabling collaboration</b><p>Business listings, connections, messaging, and discovery of professional opportunities.</p></div><div><b>03 / Supporting learning</b><p>Webinars, events, and programs to encourage knowledge sharing across the industry.</p></div></div></section>}
{gallery.length > 0 && <div class="screens">{gallery.map((item, i) => (
  <figure>
    <img src={asset(item.image)} alt={item.alt || item.caption || `${project.title} screenshot ${i+1}`} loading="lazy" />
    {item.caption && <figcaption>{item.caption}</figcaption>}
  </figure>
))}</div>}
<section class="note"><b>About this case study</b><p>{project.notes} This is an initial portfolio draft; detailed process artifacts and verified outcomes can be added through the CMS.</p></section>
</div></div><div class="case-end"><a href={`${root}/#work`} class="button-primary">More projects ↗</a></div></main></Base>
<style>
.case{padding:55px 0}.back{color:#80788a;font-size:13px;font-weight:700}.kicker{margin:50px 0 12px;letter-spacing:2px;text-transform:uppercase;font-size:12px;color:#856dbd;font-weight:800}.case h1{font:800 clamp(52px,8vw,105px)/1.09 Manrope,sans-serif;letter-spacing:-5px;margin:0}.star{color:#edb8a3}.lead{font-size:clamp(18px,2.5vw,27px);color:#7c7586;margin:20px 0 50px}.hero-img{border-radius:26px;overflow:hidden;background:#f0eaf9}.hero-img img{width:100%;max-height:710px;object-fit:contain}.case-content{display:grid;grid-template-columns:220px 1fr;gap:65px;max-width:1030px;margin:75px auto}.case-content aside{border-top:1px solid #e4dde4;padding-top:24px}.case-content aside span{display:block;font-size:11px;letter-spacing:1.4px;color:#8d7ca6;font-weight:800}.case-content aside p{font-size:14px;color:#605c65;margin:9px 0 36px}.story section{margin-bottom:65px}.story h2{font:800 clamp(27px,3vw,39px) Manrope,sans-serif;letter-spacing:-1.8px;margin:0 0 16px}.story p{font-size:16px;line-height:1.95;color:#726e7b}.pillar-list{display:grid;gap:12px}.pillar-list>div{background:#f0eafb;padding:20px 25px;border-radius:16px}.pillar-list b{font-size:15px}.pillar-list p{margin:7px 0 0;font-size:14px}.screens{display:grid;grid-template-columns:1fr 1fr;gap:16px}.screens figure{margin:0;background:#f2eff4;border-radius:16px;padding:12px}.screens img{width:100%;height:290px;object-fit:contain}.screens figcaption{font-size:12px;color:#756d7c;padding:10px}.story .note{border-left:4px solid #bea9ee;padding:5px 0 5px 20px}.story .note p{font-size:13px}.case-end{text-align:center}@media(max-width:700px){.case{padding-top:30px}.case h1{letter-spacing:-3px}.case-content{grid-template-columns:1fr;gap:25px;margin:45px auto}.case-content aside{display:none}.screens{grid-template-columns:1fr}.screens img{height:340px}}
</style>
